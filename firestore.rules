rules_version = '2';

// Billy — règles de sécurité Firestore.
// Chaque utilisateur ne peut lire et écrire que ses propres données, sous users/{uid}/…
// Tout le reste est refusé.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Mode visiteur (T-048, docs/specs/famille.md) : un proche invité lit le compte qui l'a invité, sans jamais écrire.
    function isViewerOf(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/viewers/$(request.auth.uid))
        && get(/databases/$(database)/documents/viewers/$(request.auth.uid)).data.owner == uid;
    }

    // Une invitation : créée par le propriétaire, lue seulement par qui a son code. R-070 : elle vaut 7 jours au plus
    // (expiresAt), ne sert qu'une fois (le proche qui l'a acceptée la supprime) ; le propriétaire liste et supprime
    // les siennes (« Retirer »).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && code.size() >= 12
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid
        || (exists(/databases/$(database)/documents/viewers/$(request.auth.uid))
          && get(/databases/$(database)/documents/viewers/$(request.auth.uid)).data.code == code));
    }

    // Un spectateur : il se déclare lui-même avec un code d'invitation valable ; le propriétaire le voit et le retire.
    match /viewers/{viewerId} {
      allow read: if isOwner(viewerId) || (signedIn() && resource.data.owner == request.auth.uid);
      allow create: if isOwner(viewerId)
        && request.resource.data.owner != request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.owner == request.resource.data.owner
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.expiresAt > request.time;
      allow delete: if isOwner(viewerId) || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // La meute (docs/specs/communaute.md) : lisible par tout compte connecté de l'app, jamais par un visiteur.
    // Chacun ne crée ou ne modifie que ce qui porte son uid. Les données privées restent sous users/{uid}.
    match /community/meute/members/{memberId} {
      allow read: if signedIn();
      allow write: if isOwner(memberId);
    }
    match /community/meute/spots/{spotId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /calm/{memberId} {
        allow read: if signedIn();
        allow write: if isOwner(memberId);
      }
    }
    match /community/meute/marks/{markId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /community/meute/feed/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /community/meute/challenges/{week}/rows/{memberId} {
      allow read: if signedIn();
      allow write: if isOwner(memberId);
    }

    // Le compte lui-même (users/{uid}) : son propriétaire, et ses spectateurs en lecture.
    match /users/{uid} {
      allow read: if isOwner(uid) || isViewerOf(uid);
    }

    // Un spectateur lit tout le compte, sauf les documents (papiers, ordonnances), les abonnements aux rappels (push)
    // et le journal privé de mesure (journal, T-066),
    // qui restent privés. Les fichiers ont leur propre règle juste dessous.
    // (Une seule règle qui autorise suffit : l'exception est donc écrite ici, pas dans une règle à part.)
    match /users/{uid}/{collection}/{rest=**} {
      allow read: if !(collection in ['documents', 'push', 'files', 'journal']) && isViewerOf(uid);
    }

    // R-069 : un fichier dit s'il est une photo ou une page de document ; le spectateur ne lit que les photos
    // (une requête de liste doit donc filtrer sur kind == 'photo'). Les morceaux d'un PDF suivent leur fichier.
    match /users/{uid}/files/{fileId} {
      allow read: if isViewerOf(uid) && resource.data.get('kind', '') == 'photo';
      match /chunks/{n} {
        allow read: if isViewerOf(uid)
          && get(/databases/$(database)/documents/users/$(uid)/files/$(fileId)).data.get('kind', '') == 'photo';
      }
    }

    match /users/{uid}/{document=**} {
      allow read, delete: if isOwner(uid);
      // Garde-fou : aucun document au-delà de 1 000 000 d'octets de données binaires.
      allow create, update: if isOwner(uid)
        && (!('data' in request.resource.data) || request.resource.data.data.size() < 1000000);
    }
  }
}
